# --- Postgres ---
POSTGRES_DB=davidtaxi
POSTGRES_USER=davidtaxi
POSTGRES_PASSWORD=zmen-ma-silne-heslo

# --- App ---
# port na Docker hoste, sem smeruje Nginx Proxy Manager
APP_PORT=8088
PUBLIC_URL=https://taxi.pidiman.sk
JWT_SECRET=zmen-ma-openssl-rand-hex-32

# Prvý admin (vytvorí sa len ak je tabuľka users prázdna)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=zmen-ma-admin-heslo

# Cenník (rychletaxi.sk): minimálne jazdné + sadzba za km
PRICE_MIN=3.50
PRICE_PER_KM=1.00

# Web Push (VAPID) – deploy.sh vygeneruje automaticky; ručne: docker compose run --rm --no-deps app node apps/api/dist/vapid.js
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:jakub.demeter@gmail.com

# Navigácia vo PWA vodiča (výpočet trasy). Predvolene verejný OSRM demo server (limit ~1 req/s,
# bez záruky). Na ostrú prevádzku vlastný OSRM s mapou SK + AT, napr. http://192.168.1.121:5000
OSRM_URL=https://router.project-osrm.org

# Logy: info = biznis udalosti + chyby; debug = aj každý úspešný request
LOG_LEVEL=info
# Koľko dní držať logy v Admin → Logy (tabuľka audit_log)
LOG_RETENTION_DAYS=90
